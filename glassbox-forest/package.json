{
  "name": "glassbox-forest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GLASSBOX Forest — governed, closed-loop, evidence-first experience-discovery ecosystem: a D2 geometry, a seeded branch generator, and a FOREST epoch ledger (geometrical memory). Growth is driven ONLY by real human play.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:branches": "tsx scripts/generate_branches.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
