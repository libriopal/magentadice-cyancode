# GLASSBOX Forest — environment template. Real values are SECRETS (Gate G3): a human provides them at
# runtime; never commit real values. Absent these, the app runs fully closed-loop and the Cohere proposer
# degrades to its deterministic path (no network, no spend).

# G3 — Cohere (node-side only; never exposed to the browser bundle)
COHERE_API_KEY=          # scoped key; enables real Cohere-enriched proposals + spend
COHERE_PROPOSAL_MODEL=command-r-08-2024

# G3 — real database (replaces LocalStoragePersistence only after G3 is granted)
DATABASE_URL=            # e.g. postgres://... — leave blank to stay on local persistence
