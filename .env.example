# Copy this file to .env.local and fill in your machine-specific values.
# .env.local is gitignored. NEVER commit actual tokens or paths.

# BrightData MCP token
# Revoke the old token at: https://brightdata.com/cp/api_tokens
# Then generate a new one and paste it here.
BRIGHTDATA_TOKEN=your_token_here

# Absolute path to your local Godot executable
GODOT_PATH=/path/to/godot

# Absolute path to the godot-mcp build directory (contains build/index.js)
# Clone from: https://github.com/... (add URL when known)
GODOT_MCP_PATH=/path/to/godot-mcp

# Absolute path to this repo root (used by MCP filesystem server)
REPO_ROOT=/path/to/magentadice-cyancode
